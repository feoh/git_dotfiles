Host daily-firehose daily-firehose.reedfish-regulus.ts.net
    User ubuntu

# Little Fedi administration.
Host little-fedi little-fedi.reedfish-regulus.ts.net
    HostName little-fedi.reedfish-regulus.ts.net
    User feoh
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Read-only dashboard inspection.
Host homelab-dashboard
    HostName homelab-dashboard.reedfish-regulus.ts.net
    User ubuntu
    BatchMode yes

# Offer only the file key.
Host sxelo
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# No host key checking anywhere: never record keys, never prompt, never refuse.
Host *
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    GlobalKnownHostsFile /dev/null
    LogLevel ERROR
