# Fastmail (personal). MIT lives in ~/.config/mutt/mitrc -- use `mutt -F` for that.
#
# Mutt loads only the first config it finds, in this order:
#   ~/.muttrc, ~/.mutt/muttrc, ~/.config/mutt/muttrc
# Creating either of the first two silently shadows this entire file.

# VARIABLES
set my_server = imap.fastmail.com
set my_user = feoh@fastmail.com
# 1Password item "FastmailMutt", referenced by id so a rename can't break it.
set my_pass = `op item get wq3hulaszvi3qhcmtrvixzmoiu --reveal --field password`

set from = "feoh@feoh.org"
set realname = "Chris Patti"

# IMAP SETTINGS
set imap_user = $my_user
set imap_pass = $my_pass
set folder = "imaps://$my_server/"
set mbox = "+INBOX"
set postponed = "+Drafts"
set record = "+Sent Items"
set spoolfile = "+INBOX"
set trash = "+Trash"
set ssl_force_tls = yes
set imap_check_subscribed
set move = no

# SMTP SETTINGS
# Delivery goes through msmtp, which picks its account from the envelope
# sender. Do not set smtp_url here: it silently overrides sendmail, and
# mutt's builtin SMTP can't authenticate on macOS, whose system libsasl2
# ships no PLAIN/LOGIN plugin ("No authenticators available").
# Unqualified so it resolves via PATH on both macOS and Linux.
set sendmail = "msmtp"
set use_from = yes
set envelope_from = yes

# CACHES
set header_cache = ~/.cache/mutt/headers
set message_cachedir = ~/.cache/mutt/bodies
set certificate_file = ~/.config/mutt/certificates

# UI
set sort = 'threads'
set sort_aux = 'last-date-received'
set editor = 'nvim'

source ~/.config/mutt/mime.rc

# Open URLs in emails
macro index,pager \cb "<pipe-message> urlscan<Enter>" "call urlscan to extract URLs out of a message"
macro attach,compose \cb "<pipe-entry> urlscan<Enter>" "call urlscan to extract URLs out of a message"

# Catppuccin Mocha for Mutt. These use the ANSI palette supplied by the
# Catppuccin Mocha Ghostty theme, rather than xterm's default colors.

color normal      default default         # Text on Base

# Index. ~U includes both new (N) and old-unread (O) messages; ~N only
# colored the handful of newly delivered messages in the original theme.
color index       color2 default ~U       # Unread: Green
color index       color1 default ~F       # Flagged: Red
color index       color5 default ~T       # Tagged: Pink
color index       color1 default ~D       # Deleted: Red
color indicator   default color8          # Selected row: Text on Surface 2
color tree        color15 default         # Thread tree: Subtext 1

# General UI. Giving status and search a background keeps them from looking
# like ordinary message text.
color status      default color8          # Status bar: Text on Surface 2
color search      color0 color11          # Search match: Surface 1 on Yellow
color error       color1 default          # Errors: Red
color message     color2 default          # Informational messages: Green
color prompt      color5 default          # Prompts: Pink
color markers     color1 default          # Pager continuation markers: Red
color tilde       color8 default          # Blank-line padding: Surface 2
color attachment  color5 default          # Attachments: Pink
color signature   color8 default          # Signatures: Surface 2
color bold        color4 default          # Rendered bold: Blue
color underline   color4 default          # Rendered underline: Blue

# Headers and quoted text.
color hdrdefault  color7 default          # Headers: Subtext 0
color header      color5 default "^From:"
color header      color5 default "^Subject:"
color quoted      color15 default         # Subtext 1
color quoted1     color7 default          # Subtext 0
color quoted2     color8 default          # Surface 2
color quoted3     color0 default          # Surface 1
color quoted4     color0 default
color quoted5     color0 default

# Message-body highlights.
color body color6 default [\-\.+_a-zA-Z0-9]+@[\-\.a-zA-Z0-9]+               # Email addresses: Teal
color body color4 default (https?|ftp)://[\-\.,/%~_:?&=\#a-zA-Z0-9]+        # URLs: Blue
color body color4 default (^|[[:space:]])\\*[^[:space:]]+\\*([[:space:]]|$) # *bold*: Blue
color body color4 default (^|[[:space:]])_[^[:space:]]+_([[:space:]]|$)     # _underline_: Blue
color body color4 default (^|[[:space:]])/[^[:space:]]+/([[:space:]]|$)     # /italic/: Blue

color sidebar_flagged color1 default      # Flagged mailbox: Red
color sidebar_new     color2 default      # Mailbox with unread mail: Green
