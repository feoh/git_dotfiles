Host iscahack.feoh.org
    IdentityFile ~/.ssh/iscahack

Host daily-firehose daily-firehose.reedfish-regulus.ts.net
    User ubuntu
    StrictHostKeyChecking no
    UserKnownHostsFile ~/.ssh/known_hosts

# Little Fedi administration; preserve the provisioning host pin.
Host little-fedi little-fedi.reedfish-regulus.ts.net
    HostName little-fedi.reedfish-regulus.ts.net
    User feoh
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    HostKeyAlias little-fedi
    UserKnownHostsFile ~/.config/little-fedi/known_hosts
    StrictHostKeyChecking yes

# Read-only dashboard inspection; existing pinned host key is required.
Host homelab-dashboard
    HostName homelab-dashboard.reedfish-regulus.ts.net
    User ubuntu
    BatchMode yes
    StrictHostKeyChecking yes

Host *
  IdentityAgent ~/.1password/agent.sock
