{
  "mcpServers": {
    "witan": {
      "command": "witan",
      "args": [
        "serve"
      ],
      "env": {
        "WITAN_AUTHOR": "Christopher Patti"
      }
    },
    "rootly": {
      "url": "https://mcp.rootly.com/mcp"
    },
    "trello": {
      "url": "https://mcp.trello.com/v1"
    },
    "fastly": {
      "command": "fastly-mcp",
      "env": {
        "FASTLY_API_TOKEN": "!for op in /opt/homebrew/bin/op /usr/local/bin/op /usr/bin/op; do if [ -x $op ]; then exec $op read 'op://6duz64vzrdrddopparqyvsgu2a/nscuflq7ol5hj7vzjqsjgqh67m/credential'; fi; done; exit 127"
      }
    },
    "todoist": {
      "command": "npx",
      "args": [
        "-y",
        "@doist/todoist-mcp"
      ],
      "env": {
        "TODOIST_API_KEY": "!for op in /opt/homebrew/bin/op /usr/local/bin/op /usr/bin/op; do if [ -x $op ]; then exec $op read 'op://6duz64vzrdrddopparqyvsgu2a/xtlasifuwbtfs4dtnyynkbqbmm/credential'; fi; done; exit 127"
      }
    },
    "toolhive-swe-ci": {
      "url": "https://toolhive-swe.ci.ol.mit.edu/mcp",
      "oauth": {
        "clientId": "toolhive-swe-cli",
        "callbackUrl": "http://localhost:8080/callback"
      }
    },
    "toolhive-swe-qa": {
      "url": "https://toolhive-swe.qa.ol.mit.edu/mcp",
      "oauth": {
        "clientId": "toolhive-swe-cli",
        "callbackUrl": "http://localhost:8080/callback"
      }
    },
    "toolhive-swe-prod": {
      "url": "https://toolhive-swe.ol.mit.edu/mcp",
      "oauth": {
        "clientId": "toolhive-swe-cli",
        "callbackUrl": "http://localhost:8080/callback"
      }
    }
  }
}
