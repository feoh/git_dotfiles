_feoh_setup_fzf() {
  (( ${+commands[fzf]} )) || return 0

  local fzf_zsh
  local fzf_key_bindings_loaded
  local fzf_completion_loaded
  local fzf_shell_dir
  local -a fzf_shell_dirs

  # fzf >= 0.48 ships its own zsh integration. Capture it first so older
  # fzf releases that do not understand --zsh actually fall through here;
  # `eval "$(fzf --zsh)" || ...` can otherwise eval an empty string and
  # report success.
  if fzf_zsh="$(fzf --zsh 2>/dev/null)"; then
    eval "$fzf_zsh"
    return $?
  fi

  # Older packaged fzf installs ship standalone shell scripts instead.
  # Try the common Linux, Homebrew, pkgsrc/NetBSD, and manual-install paths.
  fzf_shell_dirs=(
    "$HOME/.fzf/shell"
    /usr/share/fzf/shell
    /usr/share/fzf
    /usr/share/doc/fzf/examples
    /usr/local/share/fzf/shell
    /usr/local/share/fzf
    /usr/local/opt/fzf/shell
    /opt/homebrew/opt/fzf/shell
    /usr/pkg/share/fzf/shell
    /usr/pkg/share/fzf
    /usr/pkg/share/examples/fzf
  )
  [[ -n ${FZF_BASE:-} ]] && fzf_shell_dirs=("$FZF_BASE/shell" "$FZF_BASE" "${fzf_shell_dirs[@]}")

  for fzf_shell_dir in "${fzf_shell_dirs[@]}"; do
    [[ -n "$fzf_shell_dir" ]] || continue
    if [[ -z "$fzf_key_bindings_loaded" && -r "$fzf_shell_dir/key-bindings.zsh" ]]; then
      source "$fzf_shell_dir/key-bindings.zsh"
      fzf_key_bindings_loaded=1
    fi
    if [[ -z "$fzf_completion_loaded" && -r "$fzf_shell_dir/completion.zsh" ]]; then
      source "$fzf_shell_dir/completion.zsh"
      fzf_completion_loaded=1
    fi
    [[ -n "$fzf_key_bindings_loaded" && -n "$fzf_completion_loaded" ]] && break
  done
}

q() {
  local url="$1"
  local question="$2"

  # Fetch the URL content through Jina
  local content=$(curl -s "https://r.jina.ai/$url")

  # Check if the content was retrieved successfully
  if [ -z "$content" ]; then
    echo "Failed to retrieve content from the URL."
    return 1
  fi

  system="
  You are a helpful assistant that can answer questions about the content.
  Reply concisely, in a few sentences.

  The content:
  ${content}
  "

  # Use llm with the fetched content as a system prompt
  llm prompt "$question" -s "$system"
}

qv() {
  local url="$1"
  local question="$2"

  # Fetch the URL content through Jina
  local subtitle_url=$(yt-dlp -q --skip-download --convert-subs srt --write-sub --sub-langs "en" --write-auto-sub --print "requested_subtitles.en.url" "$url")
  local content=$(curl -s "$subtitle_url" | sed '/^$/d' | grep -v '^[0-9]*$' | grep -v '\-->' | sed 's/<[^>]*>//g' | tr '\n' ' ')

  # Check if the content was retrieved successfully
  if [ -z "$content" ]; then
    echo "Failed to retrieve content from the URL."
    return 1
  fi

  system="
  You are a helpful assistant that can answer questions about YouTube videos.
  Reply concisely, in a few sentences.

  The content:
  ${content}
  "

  # Use llm with the fetched content as a system prompt
  llm prompt "$question" -s "$system"
}

gbclean() {
  local editor=${EDITOR:-vi}
  local tmpfile
  tmpfile=$(mktemp /tmp/git-branches.XXXXXX) || return 1

  local current_branch
  current_branch=$(git symbolic-ref --short HEAD 2>/dev/null) || {
    echo "gbclean: not a git repository" >&2
    rm -f "$tmpfile"
    return 1
  }

  local -a original
  original=("${(@f)$(git branch --format='%(refname:short)' | grep -Fxv "$current_branch")}")

  {
    printf '%s\n' "${original[@]}"
    echo "# Currently on: $current_branch (hidden here, cannot be deleted this way)"
    echo "# Delete a line below to delete that branch. Save & quit to apply."
  } > "$tmpfile"

  ${=editor} "$tmpfile"

  local -a remaining
  remaining=("${(@f)$(grep -v '^#' "$tmpfile" | grep -v '^[[:space:]]*$')}")
  rm -f "$tmpfile"

  local branch
  local -a to_delete
  for branch in "${original[@]}"; do
    [[ -z "$branch" ]] && continue
    (( ${remaining[(Ie)$branch]} )) || to_delete+=("$branch")
  done

  if (( ${#to_delete} == 0 )); then
    echo "gbclean: no branches to delete"
    return 0
  fi

  echo "gbclean: deleting ${#to_delete} branch(es): ${to_delete[*]}"
  local -a failed
  for branch in "${to_delete[@]}"; do
    git branch -d "$branch" 2>/dev/null || failed+=("$branch")
  done

  if (( ${#failed} > 0 )); then
    echo "gbclean: not fully merged, force delete? ${failed[*]}"
    local REPLY
    read "REPLY?[y/N] "
    [[ "$REPLY" == [yY] ]] && git branch -D "${failed[@]}"
  fi
}
