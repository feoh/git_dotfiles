# Credentials injected into coding-agent processes by _agent_with_op (see
# ~/.config/zsh/functions). Values are 1Password secret references, not
# secrets, so this file is safe to read; agent-op-refresh resolves it into a
# 0600 cache.
#
# Anything listed here lands in the environment of pi, claude, and every MCP
# server and extension they spawn.
#
# Do not write a bare reference URI in a comment: op inject resolves those too,
# and an unresolvable one fails the whole file.

# Read by ~/.pi/agent/extensions/trello/index.ts
TRELLO_API_KEY=op://Private/Trello_API/credential
TRELLO_TOKEN=op://Private/Trello_API/token

# Read by the fastly and todoist MCP servers in ~/.pi/agent/mcp.json
FASTLY_API_TOKEN=op://6duz64vzrdrddopparqyvsgu2a/nscuflq7ol5hj7vzjqsjgqh67m/credential
TODOIST_API_KEY=op://6duz64vzrdrddopparqyvsgu2a/xtlasifuwbtfs4dtnyynkbqbmm/credential

# Referenced by item ID because the title ("Google Gemini API") contains spaces
GEMINI_API_KEY=op://Private/2afmte3m2astkoofsrwafwp6nm/credential

# Deliberately omitted: OPENAI_API_KEY and ANTHROPIC_API_KEY. pi authenticates
# via openai-codex OAuth and Claude Code via subscription; exporting these
# silently switches both to metered per-token API billing.
